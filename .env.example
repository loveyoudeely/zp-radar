# Public browser configuration. The publishable/anon key is visible in the built site.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never expose these in client code or Vercel browser config.
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Telegram MTProto userbot. Store the session string as a secret.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=
TELEGRAM_TARGET_CHANNEL=
